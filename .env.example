# ==========================================
# Business Team Multi-Agent System
# Environment Configuration
# ==========================================
# Copy this file to .env and fill in your values

# --- Anthropic API (Required) ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-sonnet-4-20250514

# --- Email Configuration (Optional — demo data used if not set) ---
EMAIL_IMAP_SERVER=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# --- Calendar Configuration (Optional) ---
CALENDAR_PROVIDER=google
CALENDAR_CREDENTIALS=path/to/credentials.json
CALENDAR_ID=primary

# --- SPL Digital Channels API (Optional — demo data used if not set) ---
SPL_API_URL=https://api.spl.example.com
SPL_API_KEY=your-spl-api-key

# --- Scheduling ---
DAILY_BRIEF_TIME=08:00
WEEKLY_REPORT_DAY=sunday
MONTHLY_REPORT_DAY=1
EMAIL_CHECK_INTERVAL=30

# --- Logging ---
LOG_LEVEL=INFO
