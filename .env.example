# ==========================================
# Business Team Multi-Agent System
# Environment Configuration
# ==========================================
# Copy this file to .env and fill in your values

# --- Anthropic API (Required) ---
ANTHROPIC_API_KEY=sk-ant-your-key-here
CLAUDE_MODEL=claude-sonnet-4-20250514

# --- Gmail (Personal — Optional, demo data used if not set) ---
GMAIL_ADDRESS=your-email@gmail.com
GMAIL_APP_PASSWORD=your-gmail-app-password

# --- Google Calendar (Personal — Optional) ---
GOOGLE_CREDENTIALS_FILE=business_team/credentials.json

# --- SPL Exchange (Work — Optional, demo data used if not set) ---
SPL_EMAIL=your-email@splonline.com.sa
SPL_PASSWORD=your-exchange-password
SPL_DISPLAY_NAME=Your Name

# --- Legacy Email Configuration (Optional) ---
EMAIL_IMAP_SERVER=imap.gmail.com
EMAIL_IMAP_PORT=993
EMAIL_SMTP_SERVER=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=

# --- SPL Digital Channels API (Optional — demo data used if not set) ---
SPL_API_URL=https://api.spl.example.com
SPL_API_KEY=your-spl-api-key

# --- Scheduling ---
DAILY_BRIEF_TIME=08:00
WEEKLY_REPORT_DAY=sunday
MONTHLY_REPORT_DAY=1
EMAIL_CHECK_INTERVAL=30

# --- Logging ---
LOG_LEVEL=INFO
